# Copy to .env and replace the placeholder before starting Compose.
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_USER=gateway
POSTGRES_DB=agentic_gateway
GATEWAY_PORT=8000
GATEWAY_IMAGE=agentic-gateway:dev
OPERATOR_API_KEY=replace-with-a-local-random-operator-key
# Optional: used only for documented GET /v1/models on api.siliconflow.cn.
SILICONFLOW_CN_CATALOG_API_KEY=
# Polling does not enable schedules. Source schedules are explicitly configured via admin API.
SCHEDULER_POLL_SECONDS=2
# Inference credential, resolved only at invocation. No live probe without --live.
NVIDIA_API_KEY=
